{
  "name": "one-more-piece",
  "private": true,
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"shared/**/*.css\" \"library/**/*.css\" \"games/**/*.css\" --max-warnings 0",
    "lint": "npm run lint:js && npm run lint:css",
    "test": "node --test --test-concurrency=1 games/*/tests/*.test.cjs tests/*.test.cjs tests/*.test.mjs",
    "check": "npm run lint && npm test && git diff --check"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "stylelint": "18.0.0"
  }
}
